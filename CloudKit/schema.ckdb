DEFINE SCHEMA

    RECORD TYPE DeepLink (
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE QUERYABLE,
        app               STRING,
        deliveredAt       TIMESTAMP,
        expiresAt         TIMESTAMP,
        fingerprint       STRING,
        opensExactContent INT64,
        readAt            TIMESTAMP QUERYABLE,
        url               ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE Verdict (
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE QUERYABLE,
        actionAt          TIMESTAMP QUERYABLE,
        app               STRING,
        body              ENCRYPTED STRING,
        category          STRING,
        deletedAt         TIMESTAMP,
        interest          INT64,
        isUnread          INT64,
        readAt            TIMESTAMP,
        reason            ENCRYPTED STRING,
        requestedCategory STRING,
        title             ENCRYPTED STRING,
        triagedAt         TIMESTAMP QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE Correspondents (
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE QUERYABLE,
        count             INT64,
        hashes            LIST<STRING>,
        updatedAt         TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE Companion (
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE QUERYABLE,
        appVersion        STRING,
        apps              LIST<STRING>,
        lastSeenAt        TIMESTAMP,
        name              STRING,
        syncRequestedAt   TIMESTAMP QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );
