DEFINE SCHEMA

    RECORD TYPE DeepLink (
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE QUERYABLE,
        app               STRING,
        deliveredAt       TIMESTAMP,
        expiresAt         TIMESTAMP,
        fingerprint       STRING,
        opensExactContent INT64,
        readAt            TIMESTAMP QUERYABLE,
        url               ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE Verdict (
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE QUERYABLE,
        actionAt          TIMESTAMP QUERYABLE,
        app               STRING,
        body              ENCRYPTED STRING,
        category          STRING,
        deletedAt         TIMESTAMP,
        deliveredAt       TIMESTAMP,
        interest          INT64,
        isUnread          INT64,
        macCategory       STRING,
        macConfidence     DOUBLE,
        macEngine         STRING,
        macInterest       INT64,
        macReason         ENCRYPTED STRING,
        readAt            TIMESTAMP,
        reason            ENCRYPTED STRING,
        recipients        ENCRYPTED STRING,
        sender            ENCRYPTED STRING,
        subtitle          ENCRYPTED STRING,
        requestedCategory STRING,
        sortRequestedAt   TIMESTAMP QUERYABLE,
        title             ENCRYPTED STRING,
        triagedAt         TIMESTAMP QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE Correspondents (
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE QUERYABLE,
        count             INT64,
        hashes            LIST<STRING>,
        updatedAt         TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE Companion (
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE QUERYABLE,
        appVersion        STRING,
        apps              LIST<STRING>,
        lastSeenAt        TIMESTAMP,
        name              STRING,
        syncRequestedAt   TIMESTAMP QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE MacPresence (
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE QUERYABLE,
        isAtMac           INT64,
        lastActiveAt      TIMESTAMP QUERYABLE,
        name              STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );

    RECORD TYPE SortingSettings (
        "___createTime"     TIMESTAMP,
        "___createdBy"      REFERENCE,
        "___etag"           STRING,
        "___modTime"        TIMESTAMP,
        "___modifiedBy"     REFERENCE,
        "___recordID"       REFERENCE QUERYABLE,
        appVersion          STRING,
        correctionThreshold DOUBLE,
        corrections         ENCRYPTED STRING,
        policy              ENCRYPTED STRING,
        updatedAt           TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_icloud"
    );
